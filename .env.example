# Copy to .env and adjust. Every setting is optional; defaults are shown.
# All variables use the FINOPS_ prefix.

# --- AWS access (read-only) ---
# Named profile from ~/.aws/credentials. Leave unset to use the default
# credential chain (env vars, SSO, instance role, ...).
# FINOPS_AWS_PROFILE=my-profile

# Comma-separated regions to scan. Leave unset to auto-discover every region
# your account has opted into. Narrowing this makes scans much faster.
# FINOPS_REGIONS=us-east-1,us-west-2

# Region used for global/billing endpoints (Cost Explorer, Cost Optimization Hub).
# FINOPS_BILLING_REGION=us-east-1

# --- Analysis windows ---
# Days of cost history pulled from Cost Explorer.
# FINOPS_COST_LOOKBACK_DAYS=30
# Days of CloudWatch metrics used to judge idle/underutilized resources.
# FINOPS_METRIC_LOOKBACK_DAYS=14
# Parallel region/service collection workers.
# FINOPS_MAX_WORKERS=8

# --- Storage ---
# SQLite file holding scan history. Defaults to ./data/finops.db
# FINOPS_DB_PATH=data/finops.db

# --- LLM advisor (pluggable) ---
# One of: bedrock | anthropic | openai | none
# FINOPS_LLM_PROVIDER=bedrock

# Bedrock (uses the same AWS credentials as the scan; no API key needed)
# FINOPS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# FINOPS_BEDROCK_REGION=us-east-1

# Anthropic API
# FINOPS_ANTHROPIC_API_KEY=sk-ant-...
# FINOPS_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI API
# FINOPS_OPENAI_API_KEY=sk-...
# FINOPS_OPENAI_MODEL=gpt-4o
# FINOPS_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Rule thresholds ---
# Any threshold can be overridden with a double underscore.
# FINOPS_THRESHOLDS__CPU_IDLE_PERCENT=3
# FINOPS_THRESHOLDS__EBS_UNATTACHED_MIN_AGE_DAYS=14
# FINOPS_THRESHOLDS__MIN_MONTHLY_SAVINGS_USD=5
